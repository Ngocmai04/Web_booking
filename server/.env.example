# MongoDB
MONGODB_URI=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe
STRIPE_PUBLISHABLE_KEY=#------- stripe publishable key -------#
STRIPE_SECRET_KEY=#------- stripe secret key -------#
STRIPE_WEBHOOK_SECRET=#------- stripe webhook secret -------#

# Mail
# Choose provider: 'gmail' or 'brevo'. If omitted, defaults to 'gmail' when GMAIL_APP_PASSWORD is set, otherwise 'brevo'.
MAIL_PROVIDER=

# Sender email (used as the From address). For Gmail provider, this must be the Gmail account that generated the App Password.
SENDER_EMAIL=

# Gmail provider (requires 2-Step Verification + App Password)
GMAIL_APP_PASSWORD=



